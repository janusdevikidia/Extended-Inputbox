{
    "name": "Extended-Inputbox",
    "version": "1.0.1",
    "author": "Célian & Janus",
    "type": "other",
    "manifest_version": 2,
    "requires": {
        "extensions": {
            "InputBox": "*"
        }
    },
    "AutoloadClasses": {
        "ExtendedInputboxHooks": "includes/ExtendedInputboxHooks.php"
    },
    "ResourceFileModulePaths": {
        "localBasePath": "",
        "remoteExtPath": "Extended-Inputbox"
    },
    "ResourceModules": {
        "ext.extendedInputbox": {
            "scripts": [
                "Modules/ext.extendedInputbox.js"
            ],
            "dependencies": [
                "mediawiki.api",
                "mediawiki.util",
                "jquery",
                "oojs-ui-core",
                "oojs-ui-widgets",
                "oojs-ui-windows" 
            ]
        }
    },
    "Hooks": {
        "BeforePageDisplay": "ExtendedInputboxHooks::onBeforePageDisplay",
        "ParserFirstCallInit": "ExtendedInputboxHooks::onParserFirstCallInit"
    },
    "MessagesDirs": {
        "ExtendedInputbox": [
            "i18n"
        ]
    }
}
