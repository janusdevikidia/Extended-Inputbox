{
    "name": "Extended-Inputbox",
    "version": "3.0.1",
    "author": [
        "Célian",
        "Janus"
    ],
    "url": "https://github.com/Janusdevikidia/Extended-Inputbox",
    "descriptionmsg": "extendedinputbox-desc",
    "type": "parserhook",
    "manifest_version": 2,
    "requires": {
        "extensions": {
            "InputBox": "*"
        },
        "MediaWiki": ">= 1.39.0"
    },
    "AutoloadClasses": {
        "ExtendedInputboxHooks": "includes/ExtendedInputboxHooks.php",
        "ExtendedInputboxConfig": "includes/ExtendedInputboxConfig.php",
        "SpecialExtendedInputbox": "includes/SpecialExtendedInputbox.php"
    },
    "SpecialPages": {
        "Extended-Inputbox": "SpecialExtendedInputbox"
    },
    "ResourceFileModulePaths": {
        "localBasePath": "",
        "remoteExtPath": "Extended-Inputbox"
    },
    "ResourceModules": {
        "ext.extendedInputbox.fallback": {
            "scripts": [
                "Modules/ext.extendedInputbox.fallback.js"
            ],
            "styles": [
                "Modules/ext.extendedInputbox.css"
            ],
            "messages": [
                "extendedinputbox-error-popup-preload-deprecated",
                "extendedinputbox-error-invalid-bgcolor",
                "extendedinputbox-error-invalid-bordercolor",
                "extendedinputbox-error-duplicate-field"
            ]
        },
        "ext.extendedInputbox.popup": {
            "scripts": [
                "Modules/ext.extendedInputbox.popup.js"
            ],
            "dependencies": [
                "oojs-ui-core",
                "oojs-ui-widgets",
                "oojs-ui-windows",
                "mediawiki.api",
                "mediawiki.util",
                "mediawiki.Title"
            ],
            "messages": [
                "extendedinputbox-default-title",
                "extendedinputbox-btn-save",
                "extendedinputbox-btn-cancel",
                "extendedinputbox-default-pagename",
                "extendedinputbox-default-username",
                "extendedinputbox-error-unresolved-title",
                "extendedinputbox-error-preload-fetch",
                "extendedinputbox-error-filter",
                "extendedinputbox-error-publish",
                "extendedinputbox-required-marker",
                "extendedinputbox-error-field-required",
                "extendedinputbox-error-page-exists",
                "extendedinputbox-confirm-skipedit",
                "extendedinputbox-error-skipedit-forbidden"
            ]
        },
        "ext.extendedInputbox.special.styles": {
            "styles": [
                "Modules/ext.extendedInputbox.special.css"
            ]
        },
        "ext.extendedInputbox.special": {
            "scripts": [
                "Modules/ext.extendedInputbox.special.js"
            ],
            "dependencies": [
                "oojs-ui-core",
                "oojs-ui-widgets",
                "oojs-ui-windows",
                "oojs-ui.styles.icons-content",
                "mediawiki.api",
                "mediawiki.util",
                "mediawiki.widgets",
                "mediawiki.jqueryMsg"
            ],
            "messages": [
                "extendedinputbox-special",
                "extendedinputbox-special-title",
                "extendedinputbox-special-intro",
                "extendedinputbox-special-section-general",
                "extendedinputbox-special-section-fields",
                "extendedinputbox-special-section-target",
                "extendedinputbox-special-field-type",
                "extendedinputbox-special-field-page",
                "extendedinputbox-special-field-prefix",
                "extendedinputbox-special-field-default",
                "extendedinputbox-special-field-buttonlabel",
                "extendedinputbox-special-field-preload",
                "extendedinputbox-special-field-preloadparams",
                "extendedinputbox-special-field-summary",
                "extendedinputbox-special-field-popuptitle",
                "extendedinputbox-special-field-popuptext",
                "extendedinputbox-special-field-requiredmarker",
                "extendedinputbox-special-field-hidemarker",
                "extendedinputbox-special-field-skipedit",
                "extendedinputbox-special-field-bgcolor",
                "extendedinputbox-special-field-bordercolor",
                "extendedinputbox-special-type-none",
                "extendedinputbox-special-type-search",
                "extendedinputbox-special-type-create",
                "extendedinputbox-special-type-comment",
                "extendedinputbox-special-type-move",
                "extendedinputbox-special-field-row-name",
                "extendedinputbox-special-field-row-label",
                "extendedinputbox-special-field-row-options",
                "extendedinputbox-special-field-row-showif",
                "extendedinputbox-special-field-row-required",
                "extendedinputbox-special-field-type-text",
                "extendedinputbox-special-field-type-textarea",
                "extendedinputbox-special-field-type-select",
                "extendedinputbox-special-field-type-radio",
                "extendedinputbox-special-field-type-checkbox",
                "extendedinputbox-special-btn-addfield",
                "extendedinputbox-special-btn-removefield",
                "extendedinputbox-special-btn-moveup",
                "extendedinputbox-special-btn-movedown",
                "extendedinputbox-special-no-fields",
                "extendedinputbox-special-drag-hint",
                "extendedinputbox-special-generated-label",
                "extendedinputbox-special-field-target-title",
                "extendedinputbox-special-btn-load",
                "extendedinputbox-special-btn-insert",
                "extendedinputbox-special-btn-preview",
                "extendedinputbox-special-btn-publish",
                "extendedinputbox-special-wikitext-label",
                "extendedinputbox-special-preview-label",
                "extendedinputbox-special-preview-loading",
                "extendedinputbox-special-notice-newpage",
                "extendedinputbox-special-notice-loaded",
                "extendedinputbox-special-notice-inserted",
                "extendedinputbox-special-notice-published",
                "extendedinputbox-special-error-notitle",
                "extendedinputbox-special-error-load",
                "extendedinputbox-special-error-preview",
                "extendedinputbox-special-error-publish",
                "extendedinputbox-special-error-noedit",
                "extendedinputbox-special-error-noedit-detailed",
                "extendedinputbox-special-error-editconflict",
                "extendedinputbox-special-error-noinsert",
                "extendedinputbox-special-confirm-overwrite",
                "extendedinputbox-special-summary-default",
                "extendedinputbox-special-notice-copied",
                "extendedinputbox-special-btn-copy",
                "extendedinputbox-special-error-copy-failed",
                "extendedinputbox-special-status-loading",
                "extendedinputbox-special-status-previewing",
                "extendedinputbox-special-status-publishing",
                "extendedinputbox-special-warning-incomplete-field",
                "extendedinputbox-error-duplicate-field",
                "extendedinputbox-error-invalid-bgcolor",
                "extendedinputbox-error-invalid-bordercolor",
                "extendedinputbox-special-advanced-toggle",
                "extendedinputbox-special-btn-previewpopup",
                "extendedinputbox-special-preview-popup-banner",
                "extendedinputbox-default-title",
                "extendedinputbox-btn-cancel",
                "extendedinputbox-required-marker",
                "extendedinputbox-special-field-requiredmarker-placeholder",
                "extendedinputbox-special-warning-pipe-in-field",
                "extendedinputbox-error-page-exists"
            ]
        }
    },
    "Hooks": {
        "BeforePageDisplay": "ExtendedInputboxHooks::onBeforePageDisplay",
        "OutputPageBeforeHTML": "ExtendedInputboxHooks::onOutputPageBeforeHTML"
    },
    "MessagesDirs": {
        "ExtendedInputbox": [
            "i18n"
        ]
    },
    "ExtensionMessagesFiles": {
        "ExtendedInputboxAlias": "ExtendedInputbox.alias.php"
    }
}
